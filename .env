# ── REQUIRED for production (Vercel, Netlify, etc.) ──
# Set VITE_API_URL via your hosting dashboard (Vercel → Project Settings → Environment Variables)
# Example for production: VITE_API_URL=https://your-backend.onrender.com/api
# Local dev fallback (if unset): http://localhost:5001/api
VITE_API_URL=http://localhost:5001/api

# ── Google OAuth ──
# Required for Google Sign-In. Get it from: https://console.cloud.google.com/apis/credentials
# When unset, the Google Sign-In button is hidden with a "not configured" message.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
