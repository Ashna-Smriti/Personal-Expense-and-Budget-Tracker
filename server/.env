# ── Backend Configuration ──
PORT=5001

# ── REQUIRED: JWT Secret ──
# Set a strong random secret in production (never use the default).
JWT_SECRET=budget-tracker-super-secret-key-2024
JWT_EXPIRES_IN=7d

# ── REQUIRED for production ──
# Without this, the server uses an in-memory MongoDB that LOSES ALL DATA on restart.
# Get a free MongoDB Atlas cluster at https://www.mongodb.com/atlas
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/budget-tracker

# ── Google OAuth (both frontend AND backend need this) ──
# Frontend: VITE_GOOGLE_CLIENT_ID in project .env
# Backend:  GOOGLE_CLIENT_ID here (same value)
# Get it from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── CORS (comma-separated, or leave defaults to allow common hosts) ──
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
